{
  "name": "three-patti-pro",
  "private": true,
  "scripts": {
    "test": "node --test online/test/*.test.cjs",
    "check": "node --check app.js && node --check online/client.js && node --check functions/online/index.js",
    "test:rules": "node --test online/test/security.integration.cjs",
    "test:browser": "node online/test/browser.cjs",
    "sync:android": "node online/sync-android.cjs",
    "build": "node online/build.cjs",
    "test:emulators": "firebase emulators:exec --project demo-three-patti --only auth,firestore,database,functions \"npm run test:rules && npm run test:browser\"",
    "test:network": "node online/test/network.browser.cjs",
    "test:legacy-labels": "node online/test/legacy-labels.browser.cjs",
    "test:native-origin": "node online/test/native-origin.browser.cjs",
    "test:table-feedback": "node online/test/table-feedback.browser.cjs",
    "test:session-deletion": "node online/test/session-deletion.browser.cjs",
    "test:presence": "node online/test/presence.browser.cjs",
    "test:compact-table": "node online/test/compact-table.browser.cjs",
    "test:smooth-controls": "node online/test/smooth-controls.browser.cjs",
    "test:game-dialog": "node online/test/game-dialog.browser.cjs",
    "test:performance": "node online/test/performance.browser.cjs",
    "test:bots": "node --test online/test/bot-intelligence.test.cjs online/test/engine.test.cjs",
    "test:bot-comparison": "node online/test/bot-comparison.cjs",
    "test:lobby-scroll": "node online/test/lobby-scroll.browser.cjs",
    "test:card-double-tap": "node online/test/card-double-tap.browser.cjs",
    "test:card-playback": "node online/test/card-playback.browser.cjs",
    "test:usage-controls": "node online/test/usage-controls.browser.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "esbuild": "^0.25.11",
    "firebase": "^10.12.0",
    "firebase-admin": "^13.6.0",
    "playwright": "^1.56.1"
  }
}
