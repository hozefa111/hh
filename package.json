{
  "name": "three-patti-pro",
  "private": true,
  "scripts": {
    "test": "node --test online/test/*.test.cjs",
    "check": "node --check app.js && node --check online/client.js && node --check functions/online/index.js",
    "test:rules": "node --test online/test/security.integration.cjs",
    "test:browser": "node online/test/browser.cjs",
    "sync:android": "node online/sync-android.cjs",
    "build": "node online/build.cjs",
    "test:emulators": "firebase emulators:exec --project demo-three-patti --only auth,firestore,database,functions \"npm run test:rules && npm run test:browser\"",
    "test:network": "node online/test/network.browser.cjs",
    "test:legacy-labels": "node online/test/legacy-labels.browser.cjs",
    "test:native-origin": "node online/test/native-origin.browser.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "esbuild": "^0.25.11",
    "firebase": "^10.12.0",
    "firebase-admin": "^13.6.0",
    "playwright": "^1.56.1"
  }
}
